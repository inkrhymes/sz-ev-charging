# Airflow + headless JDK17 + pyspark 3.5.3 + 项目依赖，用来在 Airflow 里跑真实链路
FROM apache/airflow:2.9.3-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
USER airflow
RUN pip install --no-cache-dir "apache-airflow==2.9.3" pyspark==3.5.3 pyarrow pymysql "pandas>=2.0,<2.3" numpy pyyaml
