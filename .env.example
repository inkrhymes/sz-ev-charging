MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=sz_ev
MYSQL_USER=ev
MYSQL_PASSWORD=evpass
MYSQL_PORT=3306
API_PORT=5000

# 仅本地演示角色登录；默认关闭。不要在公网/生产环境启用。
AUTH_DEMO_ENABLED=0
# 逗号分隔的前端来源白名单；同源部署无需额外配置。
CORS_ALLOWED_ORIGINS=http://localhost:5096,http://127.0.0.1:5096
# 可选 Redis 读缓存；留空表示关闭。
REDIS_URL=
# Redis 缓存命名空间版本；部署改变响应结构时递增，避免旧缓存污染。
CACHE_VERSION=v2
# 可选性能诊断响应头（X-Response-Time-Ms），生产环境按需开启。
API_TIMING_HEADER=0
FLASK_DEBUG=0
